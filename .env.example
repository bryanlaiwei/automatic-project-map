# Local Supabase (filled by `supabase status` after `supabase start`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# GitHub App used for PR and Actions webhooks. Create in GitHub settings.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Interpretation. Model stays configurable.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Local API
API_PORT=4000
WEB_ORIGIN=http://127.0.0.1:5173

# Collector upload. Do not commit a real access token.
# APM_API_URL=http://127.0.0.1:4000
# APM_ACCESS_TOKEN=

# Browser app. These are public client values, not the service role key.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://127.0.0.1:4000
