# Local Supabase (filled by `supabase status` after `supabase start`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret for Supabase access tokens signed with HS256. Local value is the JWT secret from `supabase status`.
# Tokens signed with a Supabase signing key (ES256 or RS256, used by newer projects and the local CLI) are checked
# against SUPABASE_URL's published keys instead. Either way the API does not call Supabase Auth on each request.
SUPABASE_JWT_SECRET=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# GitHub App used for PR and Actions webhooks. Create in GitHub settings.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Interpretation. Each project owner can save their own OpenAI, Anthropic, or Gemini key in Settings.
# APM_SECRETS_KEY encrypts those keys at rest. Any long random string. Required before a key can be saved.
APM_SECRETS_KEY=
# Optional server-wide fallback used when a project owner has not saved their own key.
OPENAI_API_KEY=
# Optional; defaults to gpt-5-nano, the cheapest. Use gpt-5-mini if grouping quality is not good enough.
OPENAI_MODEL=

# Local API. On a server, HOST=0.0.0.0 (or omit HOST and use `npm start`, which listens on every interface)
# and PORT is whatever the host assigns. API_PORT is the local fallback.
# HOST=127.0.0.1
API_PORT=4000
# PORT=4000
WEB_ORIGIN=http://127.0.0.1:5173
# Postgres connections per process. Default 10. The API also opens 2 for the webhook publisher, and the
# worker opens 4 for its jobs. Point DATABASE_URL at Supabase's pooler when the plan's limit is small.
# DATABASE_POOL_MAX=10

# Helper upload. Do not commit a real access token.
# APM_API_URL=http://127.0.0.1:4000
# APM_ACCESS_TOKEN=

# Local helper (`npm run dev:helper`). Log folders default to ~/.codex/sessions,
# ~/.claude/projects, and ~/.cursor. Set a path to scan that folder instead.
# APM_HELPER_PORT=47321
# APM_HELPER_DB=collector.sqlite
# APM_SCAN_INTERVAL_MS=30000
# APM_CODEX_SESSIONS=
# APM_CLAUDE_PROJECTS=
# APM_CURSOR_SESSIONS=

# Browser app. These are public client values, not the service role key.
# `npm run build --workspace @apm/web` bakes them in. Set the real addresses before that build.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://127.0.0.1:4000
# VITE_HELPER_URL=http://127.0.0.1:47321
# Optional link shown during onboarding, e.g. https://github.com/apps/<your-app>/installations/new
# VITE_GITHUB_APP_INSTALL_URL=
