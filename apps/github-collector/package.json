{
  "name": "@apm/github-collector",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./access": { "node-dist": "./dist/access.js", "types": "./src/access.ts", "default": "./src/access.ts" },
    "./github-client": { "node-dist": "./dist/github-client.js", "types": "./src/github-client.ts", "default": "./src/github-client.ts" },
    "./enrich": { "node-dist": "./dist/enrich.js", "types": "./src/enrich.ts", "default": "./src/enrich.ts" },
    "./refresh": { "node-dist": "./dist/refresh.js", "types": "./src/refresh.ts", "default": "./src/refresh.ts" },
    "./webhook": { "node-dist": "./dist/webhook.js", "types": "./src/webhook.ts", "default": "./src/webhook.ts" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@apm/shared": "*"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
