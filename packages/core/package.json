  "dependencies": {
    "@apm/github-collector": "*",
    "@apm/shared": "*",
    "openai": "^7.23.0",
    "pg": "^8.16.3",
    "pg-boss": "^10.4.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
