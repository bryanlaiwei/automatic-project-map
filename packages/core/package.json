{
  "name": "@apm/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./auth-user": { "node-dist": "./dist/auth-user.js", "types": "./src/auth-user.ts", "default": "./src/auth-user.ts" },
    "./config": { "node-dist": "./dist/config.js", "types": "./src/config.ts", "default": "./src/config.ts" },
    "./db": { "node-dist": "./dist/db.js", "types": "./src/db.ts", "default": "./src/db.ts" },
    "./delivery-jobs": { "node-dist": "./dist/delivery-jobs.js", "types": "./src/delivery-jobs.ts", "default": "./src/delivery-jobs.ts" },
    "./helper-tokens": { "node-dist": "./dist/helper-tokens.js", "types": "./src/helper-tokens.ts", "default": "./src/helper-tokens.ts" },
    "./ingest-events": { "node-dist": "./dist/ingest-events.js", "types": "./src/ingest-events.ts", "default": "./src/ingest-events.ts" },
    "./model-credentials": { "node-dist": "./dist/model-credentials.js", "types": "./src/model-credentials.ts", "default": "./src/model-credentials.ts" },
    "./model-providers": { "node-dist": "./dist/model-providers.js", "types": "./src/model-providers.ts", "default": "./src/model-providers.ts" },
    "./secret-box": { "node-dist": "./dist/secret-box.js", "types": "./src/secret-box.ts", "default": "./src/secret-box.ts" },
    "./store": { "node-dist": "./dist/store.js", "types": "./src/store.ts", "default": "./src/store.ts" },
    "./workspace": { "node-dist": "./dist/workspace.js", "types": "./src/workspace.ts", "default": "./src/workspace.ts" },
    "./graph/context": { "node-dist": "./dist/graph/context.js", "types": "./src/graph/context.ts", "default": "./src/graph/context.ts" },
    "./graph/corrections": { "node-dist": "./dist/graph/corrections.js", "types": "./src/graph/corrections.ts", "default": "./src/graph/corrections.ts" },
    "./graph/graph-prompt": { "node-dist": "./dist/graph/graph-prompt.js", "types": "./src/graph/graph-prompt.ts", "default": "./src/graph/graph-prompt.ts" },
    "./graph/graph-read": { "node-dist": "./dist/graph/graph-read.js", "types": "./src/graph/graph-read.ts", "default": "./src/graph/graph-read.ts" },
    "./graph/model-interpreter": { "node-dist": "./dist/graph/model-interpreter.js", "types": "./src/graph/model-interpreter.ts", "default": "./src/graph/model-interpreter.ts" },
    "./graph/openai-interpreter": { "node-dist": "./dist/graph/openai-interpreter.js", "types": "./src/graph/openai-interpreter.ts", "default": "./src/graph/openai-interpreter.ts" },
    "./graph/process": { "node-dist": "./dist/graph/process.js", "types": "./src/graph/process.ts", "default": "./src/graph/process.ts" },
    "./graph/proposal": { "node-dist": "./dist/graph/proposal.js", "types": "./src/graph/proposal.ts", "default": "./src/graph/proposal.ts" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "tsx src/graph/eval-grouping.ts",
    "demo:seed": "tsx src/demo/seed-demo.ts"
